{
  "name": "toan-tu-duy-ai-netlify",
  "version": "6.6.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test:v5": "node --test tests/v5-*.test.mjs",
    "test:ui": "node scripts/check-v630-ui.mjs",
    "test:ui:legacy": "node scripts/check-ui.mjs",
    "prebuild": "node scripts/build-curriculum.mjs && node scripts/build-learning-gateway.mjs && node scripts/prepare-tikz.mjs",
    "prestart": "node scripts/prepare-tikz.mjs",
    "predev": "node scripts/prepare-tikz.mjs",
    "test:ui:v5": "node scripts/check-v5-ui.mjs",
    "test:tikz": "node scripts/check-tikz-runtime.mjs",
    "lint": "eslint . --max-warnings=0",
    "test:v623": "node --test tests/v623-*.test.mjs",
    "test:ui:v623": "node scripts/check-v623-ui.mjs",
    "test:live:v623": "node --env-file-if-exists=.env scripts/check-v623-live.mjs",
    "test:v624": "node --test tests/v624-*.test.mjs",
    "test:ui:v624": "node scripts/check-v624-ui.mjs",
    "test:v630": "node --test tests/v630-*.test.mjs",
    "test:ui:v630": "node scripts/check-v630-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:start": "node scripts/check-start.mjs",
    "pretest": "node scripts/prepare-tikz.mjs",
    "test:v640": "node --test tests/v640-*.test.mjs tests/v61-component.test.mjs",
    "review:figures": "node scripts/render-v640-review.mjs",
    "build:gateway": "node scripts/build-learning-gateway.mjs",
    "test:learning": "node --test tests/v650-*.test.mjs",
    "test:ui:v650": "node scripts/check-v650-ui.mjs",
    "test:v660": "node --test tests/v660-*.test.mjs",
    "test:ui:v660": "node scripts/check-v660-ui.mjs",
    "test:ui:regression:v660": "node scripts/check-v660-regression-ui.mjs"
  },
  "dependencies": {
    "@rod2ik/tikzjax": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "^0.16.22",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "6.0.2",
    "acorn": "8.18.0",
    "eslint": "10.11.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "react-test-renderer": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
