# Chi dat khoa that trong bien moi truong may chu / Netlify Functions.
# OpenAI API tinh phi rieng, khong mien phi theo goi ChatGPT Plus.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Tiet kiem: gpt-6-luna. Can bang: gpt-6-sol. Nang luc cao: gpt-6-astra.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# Ve hinh dung muc rieng de giam do tre; hoi thoai van dung medium.
OPENAI_DIAGRAM_REASONING_EFFORT=low
# 5.000-52.000 ms; tong moi yeu cau luon duoi 52 giay.
OPENAI_TIMEOUT_MS=50000
# Ma vao lop it nhat 10 ky tu; khong phai API key.
ACCESS_CODE=HOCGIOITOAN
# Tuy chon: khoa ky trang thai on dinh khi doi API key/provider.
# STATE_SIGNING_KEY=
# De dung cau hinh Gemini cu: AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
