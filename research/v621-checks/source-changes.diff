ry><p>{activeProblem}</p></details><ProblemFigure key={activeProblem} redrawToken={figureRevision} suspended={busy} onConnect={()=>setSettings(true)} problem={activeProblem} accessCode={code} reply={activeReply} level={learner.level} onProblemChange={q=>{setPreviewProblem(q);setInput(q);}}/></section>}<div className="conversation" ref={scrollRef} aria-label="Cuộc trò chuyện">{messages.length===0&&activeProblem?<p className="preview-hint">Em có thể đối chiếu hình và lý thuyết, rồi gửi bước em muốn cùng Thầy tìm hiểu.</p>:messages.length===0?<div className="chat-welcome"><TutorAvatar large/><span className="eyebrow">GIA SƯ HÌNH HỌC AI</span><h2>{lesson?lesson.title:mode==='review'?'Cùng xem lại từng lập luận.':'Bắt đầu từ điều em đang băn khoăn.'}</h2><p>{lesson?lesson.problem:'Em gửi đề bài và phần đã thử. Thầy sẽ cùng em đọc giả thiết, chọn hướng giải và kiểm tra từng bước.'}</p>{lesson&&<div className="inline-figure"><GeometryFigure figure={lesson.figure} title={lesson.title}/><small>Hình minh họa, không dùng thay cho giả thiết.</small></div>}<div className="start-hint"><Lightbulb size={18}/><span>{lesson?'Sơ đồ bên cạnh giúp em định hướng. Nhấn Gửi để bắt đầu.':'Thầy hỗ trợ hình học THCS, trọng tâm là tứ giác lớp 8.'}</span></div></div>:messages.map((m,i)=>{const parsed=m.role==='assistant'?parseTutorResponse(m.content):null;return <article className={`message ${m.role}`} key={i}>{m.role==='assistant'?<TutorAvatar/>:<span className="student-avatar">Em</span>}<div className="message-body"><span className="message-author">{m.role==='assistant'?'Gia sư hình học · AI':'Em'}</span>{parsed?.plan&&<details className="message-map"><summary>Sơ đồ định hướng của lượt này</summary><LearningMap plan={parsed.plan} source="Theo nội dung bài"/></details>}<div className="message-content">{i<messages.length-2?<details className="past-message"><summary>Xem lượt trao đổi trước</summary>{parsed?<MathText text={parsed.text}/>:m.content}</details>:parsed&&i===messages.length-1?<Typed text={parsed.text}/>:parsed?<MathText text={parsed.text}/>:m.content}</div></div></article>;})}{busy&&<div className="working" role="status"><TutorAvatar/><div><span className="thinking-dots"><i/><i/><i/></span><p>Thầy đang kiểm tra dữ kiện và hướng giải…</p></div><button onClick={()=>abort.current?.abort()}>Dừng</button></div>}</div>{error&&<p className="error" role="alert">{error}</p>}{messages.length>0&&!ended&&<div className="followups"><button disabled={busy||ended} onClick={()=>{setFigureRevision(v=>v+1);document.querySelector('.current-problem')?.scrollIntoView({behavior:'smooth',block:'start'});}} >Vẽ lại hình</button><button disabled={busy} onClick={()=>void send('Em cần một gợi ý nhỏ cho bước đang làm, chưa cần toàn bộ lời giải.')}>Gợi ý thêm</button><button disabled={busy} onClick={()=>void send('Thầy hãy giúp em kiểm tra đúng một bước em vừa làm; chưa đưa đáp án hoặc lời giải hoàn chỉnh.')}>Kiểm tra bước em làm</button><button disabled={busy} onClick={()=>void send('Hãy cho em một bài tương tự trong chủ đề tứ giác, chưa kèm đáp án.')}>Bài tương tự</button></div>}{ended?<div className="session-ended"><ShieldCheck size={23}/><div><strong>Buổi học đã kết thúc</strong><p>Em có thể xem lại hội thoại hoặc bắt đầu một bài mới.</p></div><button onClick={newChat}>Bài mới</button></div>:<form className="composer" onSubmit={e=>{e.preventDefault();void send();}}><label className="sr-only" htmlFor="problem">Nhập đề bài hoặc bài làm</label><textarea id="problem" ref={inputRef} value={input} rows={3} maxLength={6000} disabled={busy} placeholder={mode==='review'?'Nhập đề bài và từng bước trong lời giải của em…':'Nhập đề bài hoặc chia sẻ bước em đang vướng…'} onChange={e=>setInput(e.target.value)} onKeyDown={e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.nativeEvent.isComposing){e.preventDefault();void send();}}}/><div className="composer-bottom"><button type="button" className="preview-geometry-button" disabled={!input.trim()||busy} onClick={previewGeometry}>Xem hình & lý thuyết</button><span>{input.length}/6000 <small>· Shift + Enter để xuống dòng</small></span><button className="primary send-button" type="submit" disabled={busy||!input.trim()}>{busy?<LoaderCircle size={18} className="spin"/>:<ArrowUp size={18}/>}Gửi</button></div></form>}<p className="chat-foot">Em làm chủ nhịp học. Có thể dừng và đánh giá bất cứ lúc nào.</p></div><aside className="reasoning-panel"><LearningMap plan={displayPlan} source={mapSource}/><div className="self-check"><h3><CheckCheck size={18}/>Em tự kiểm tra</h3>{['Em nêu được giả thiết và kết luận','Em giải thích được bước then chốt','Em có thể tự làm lại'].map(s=><label key={s}><input type="checkbox" checked={checkpoints.includes(s)} onChange={e=>setCheckpoints(e.target.checked?[...checkpoints,s]:checkpoints.filter(v=>v!==s))}/><span>{s}</span></label>)}<p>Đánh dấu theo cảm nhận của em, không phải điểm do AI chấm.</p></div><LearnerPanel state={learner} onChange={setLearner}/><div className="side-tip"><span>NHỚ MỘT ĐIỀU</span><p>Hình vẽ gợi ý cho ta phỏng đoán.<br/>Lập luận mới giúp ta kết luận.</p></div></aside></div></section>}{notice&&<p className="notice" role="status">{notice}</p>}{view!=='chat'&&error&&<p className="error" role="alert">{error}</p>}<footer className="creators-footer"><a href="/poster.html">Poster khoa học online</a><small>Phiên bản 6.2</small><div><h2>NGƯỜI SÁNG TẠO</h2><p className="creator-names"><span>Phan Trí Dũng</span><span>Phạm Nam Hải</span></p><p>Giáo viên hướng dẫn: <strong>GV. Trần Ngọc Phú Sang</strong></p></div><p className="footer-purpose">Hiểu vì sao, rồi mới kết luận.<small>Phân tích · Tổng hợp · So sánh · Khái quát hóa</small></p></footer></main></div>
