+++ updated/lib/survey.ts
@@ -0,0 +1,27 @@
+import type {Profile} from './tutor';
+
+export function participantLabel(profile: Pick<Profile, 'className'> | null): string {
+  if (!profile) return 'Chưa có thông tin';
+  const className = profile.className.trim();
+  return className ? `Lớp: ${className}` : 'Giáo viên';
+}
+
+export function surveyComment({profile, comment, includeSummary, topic, mode, checkpoints}: {
+  profile: Profile;
+  comment: string;
+  includeSummary: boolean;
+  topic: string;
+  mode: string;
+  checkpoints: string[];
+}): string {
+  // The existing Google Form has five fields. Participant information belongs
+  // in its comment field, even when the optional learning summary is omitted.
+  const parts = [comment.trim(), `[Người tham gia]\n${participantLabel(profile)}`].filter(Boolean);
+  if (includeSummary) {
+    const learning = profile.className.trim()
+      ? `Khối 8; mức độ tự khai: ${profile.level}.\nMục tiêu: ${profile.goal}.\nTự kiểm tra: ${checkpoints.join('; ') || 'Chưa đánh dấu'}.`
+      : 'Nội dung tham khảo: Hình học tứ giác lớp 8.';
+    parts.push(`[Thông tin sử dụng]\nChủ đề: ${topic}; chế độ: ${mode}.\n${learning}`);
+  }
+  return parts.join('\n\n');
+}
--- baseline/lib/use-survey-reminder.ts
+++ updated/lib/use-survey-reminder.ts
@@ -0,0 +1,38 @@
+import {useEffect, useRef, useState} from 'react';
+
+export const SURVEY_INTERVAL_MS = 180_000;
+
+/** Remind on a fixed cadence; never submit or reset a survey draft. */
+export function useSurveyReminder({enabled, open, blocked, onRemind}: {
+  enabled: boolean;
+  open: boolean;
+  blocked: boolean;
+  onRemind: () => void;
+}) {
+  const [due, setDue] = useState(false);
+  const [visible, setVisible] = useState(() => typeof document !== 'undefined' && !document.hidden);
+  const callback = useRef(onRemind);
+  useEffect(() => { callback.current = onRemind; }, [onRemind]);
+
+  useEffect(() => {
+    if (!enabled) { setDue(false); return; }
+    const timer = setInterval(() => setDue(true), SURVEY_INTERVAL_MS);
+    return () => clearInterval(timer);
+  }, [enabled]);
+
+  useEffect(() => {
+    const update = () => setVisible(!document.hidden);
+    document.addEventListener('visibilitychange', update);
+    return () => document.removeEventListener('visibilitychange', update);
+  }, []);
+
+  useEffect(() => {
+    if (!enabled || !due) return;
+    // An already open survey counts as this reminder; closing it must not
+    // immediately open another one. Multiple overdue ticks merge into one.
+    if (open) { setDue(false); return; }
+    if (!visible || blocked) return;
+    setDue(false);
+    callback.current();
+  }, [enabled, due, visible, open, blocked]);
+}
