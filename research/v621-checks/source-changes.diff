r.level}`:'Giáo viên'):'Bắt đầu bằng một câu hỏi tốt'}</small></div></div></aside>
+ <main id="main" className="main-panel">{view==='home'?<section className="home-page fade"><div className="home-hero"><div className="hero-copy"><span className="eyebrow">KHÁM PHÁ HÌNH HỌC · RÈN LUYỆN TƯ DUY</span><h1>Cùng tìm ra<br/><em>cách nghĩ</em> cho<br/> mỗi bài hình.</h1><p>Đọc đúng giả thiết. Kết nối kiến thức.<br/>Tự xây dựng lời giải với một người bạn đồng hành.</p><div className="hero-actions"><button className="primary" onClick={()=>choose('guide')}>Bắt đầu khám phá <ArrowUpRight size={18}/></button><button className="quiet" onClick={()=>setView('bank')}>Xem bài tập mẫu <ChevronRight size={17}/></button></div><div className="hero-proof"><span><Check size={14}/>Gợi mở từng bước</span><span><Check size={14}/>Có sơ đồ định hướng</span></div></div><div className="hero-visual" aria-label="Hình học qua các đường kết nối"><div className="visual-caption"><span className="mini-dot"/>MỘT HÌNH VẼ, NHIỀU KẾT NỐI</div><GeometryFigure figure={lessons[0].figure} title="Tứ giác và bốn trung điểm" large/><span className="floating-label label-top">Giả thiết → Kết nối</span><span className="floating-label label-bottom"><Lightbulb size={16}/>Điều gì làm nên một lời giải?</span><div className="visual-foot"><span>ABCD</span><span>EFGH</span><span>Phân tích · Tổng hợp</span></div></div></div><div className="learning-route"><div><span>01</span><p><strong>Nhìn rõ bài toán</strong><small>Tách giả thiết và mục tiêu</small></p></div><ChevronRight size={18}/><div><span>02</span><p><strong>Tìm mối liên hệ</strong><small>Chọn dấu hiệu có căn cứ</small></p></div><ChevronRight size={18}/><div><span>03</span><p><strong>Tự kiểm tra</strong><small>Giải thích và vận dụng lại</small></p></div></div><div className="section-heading"><div><span className="eyebrow">BẮT ĐẦU TỪ MỘT THỬ THÁCH</span><h2>Những bài hình đáng để suy ngẫm</h2></div><button className="text-button" onClick={()=>setView('bank')}>Tất cả bài tập <ArrowUpRight size={17}/></button></div><div className="lesson-grid">{lessons.slice(0,3).map((l,i)=><button className="lesson-card" key={l.id} disabled={busy} onClick={()=>prepareLesson(l)}><div className={`card-figure tint-${i}`}><GeometryFigure figure={l.figure} title={l.title}/><span className="level-label">{l.level}</span></div><div className="card-body"><small>{l.topic} · {l.minutes} phút gợi ý</small><h3>{l.title}</h3><p>{l.operation}</p><span className="card-link">Cùng Thầy khám phá <ArrowUpRight size={17}/></span></div></button>)}</div></section>:view==='bank'?<section className="bank-page fade"><div className="section-heading"><div><span className="eyebrow">NGÂN HÀNG BÀI TẬP</span><h1>Quen dạng bài.<br/>Sâu cách nghĩ.</h1></div><span className="page-number">{lessons.length+worksheets.length} <small>bài gợi mở</small></span></div><p className="lead">Trung điểm, đường chéo, dấu hiệu nhận biết và những kết luận cần kiểm tra.</p><div className="topic-filters" aria-label="Lọc theo chủ đề">{topicList.map(t=><button key={t} aria-pressed={filter===t} className={filter===t?'selected':''} onClick={()=>setFilter(t)}>{t}</button>)}</div><div className="lesson-grid bank-grid">{lessons.filter(l=>filter==='Tất cả'||l.topic===filter).map((l,i)=><button className="lesson-card" key={l.id} disabled={busy} onClick={()=>prepareLesson(l)}><div className={`card-figure tint-${i%3}`}><GeometryFigure figure={l.figure} title={l.title}/><span className="level-label">{l.level}</span></div><div className="card-body"><small>{l.topic} · {l.minutes} phút gợi ý</small><h3>{l.title}</h3><p>{l.operation}</p><span className="card-link">Khám phá bài toán <ArrowUpRight size={17}/></span></div></button>)}</div><WorksheetBank disabled={busy} onChoose={prepareWorksheet}/></section>:view==='practice'?<section className="practice-page fade"><span className="eyebrow">RÈN LUYỆN HÌNH HỌC TỨ GIÁC</span><h1>{mode==='test'?'Tự làm. Tự kiểm tra.':'Một chút luyện tập, mỗi ngày.'}</h1><p className="lead">Chọn một chủ đề và mức độ phù hợp. Mình sẽ bắt đầu bằng đề bài, rồi cùng kiểm tra cách làm.</p><div className="practice-layout"><form className="practice-card" onSubmit={e=>{e.preventDefault();generate();}}><div className="form-grid"><label>Chủ đề<select value={topic} onChange={e=>setTopic(e.target.value)}>{topicList.slice(1).map(t=><option key={t}>{t}</option>)}</select></label><label>Mức độ<select value={difficulty} onChange={e=>setDifficulty(e.target.value)}>{['Củng cố','Vận dụng','Vận dụng cao'].map(t=><option key={t}>{t}</option>)}</select></label><label>Số câu<select value={count} onChange={e=>setCount(e.target.value)}>{[5,6,7,8,9,10].map(n=><option key={n}>{n}</option>)}</select></label><label>Nội dung<input value="Tứ giác · Hình học 8" readOnly/></label></div><button className="primary" disabled={busy}>Tạo {count} câu {mode==='test'?'tự kiểm tra':'luyện tập'} <ArrowUpRight size={18}/></button><p className="caption">Bài do AI tạo cần được kiểm tra. Thầy hỏi gợi mở từng bước; không cung cấp đáp án hay lời giải hoàn chỉnh.</p></form><div className="practice-note"><Target size={28}/><h3>Mục tiêu là hiểu cách làm.</h3><p>Sau mỗi câu, hãy thử trả lời: “Vì sao em chọn dấu hiệu này?” rồi tự làm một bài tương tự.</p></div></div></section>:<section className="chat-page fade"><div className="chat-heading"><div><span className="eyebrow">KHÔNG GIAN SUY NGHĨ</span><h1>{selected.title}{selected.status&&<span className="mode-status"> ({selected.status})</span>}</h1></div><div className="lesson-actions"><button disabled={busy} onClick={newChat}><Plus size={16}/>Bài mới</button><button className="finish-button" onClick={openSurvey}><CheckCheck size={17}/><span>Khảo sát đánh giá ứng dụng</span></button></div></div><div className="study-layout"><div className="chat-column">{activeProblem&&<section className="current-problem">{messages.filter(m=>m.role==='assistant').at(-1)?.thinking&&<div className="current-question"><span className="eyebrow">BƯỚC EM TỰ LÀM</span><p>{messages.filter(m=>m.role==='assistant').at(-1)?.thinking?.question}</p></div>}<details className="current-statement" open><summary>Đề bài đang học</summary><p>{activeProblem}</p></details><ProblemFigure key={activeProblem} redrawToken={figureRevision} suspended={busy} onConnect={()=>setSettings(true)} problem={activeProblem} accessCode={code} reply={activeReply} level={learner.level} onProblemChange={q=>{setPreviewProblem(q);setInput(q);}}/></section>}<div className="conversation" ref={scrollRef} aria-label="Cuộc trò chuyện">{messages.length===0&&activeProblem?<p className="preview-hint">Em có thể đối chiếu hình và lý thuyết, rồi gửi bước em muốn cùng Thầy tìm hiểu.</p>:messages.length===0?<div className="chat-welcome"><TutorAvatar large/><span className="eyebrow">GIA SƯ HÌNH HỌC AI</span><h2>{lesson?lesson.title:mode==='review'?'Cùng xem lại từng lập luận.':mode==='compare'?'Cùng đối chiếu hai ý tưởng.':'Bắt đầu từ điều em đang băn khoăn.'}</h2><p>{lesson?lesson.problem:mode==='review'?'Em gửi đề bài và bước em đã viết. Thầy sẽ cùng em kiểm tra căn cứ, bắt đầu từ chỗ đầu tiên cần làm rõ.':mode==='compare'?'Em gửi đề bài và hai ý tưởng muốn đối chiếu. Nếu mới có một hướng, mình sẽ bắt đầu từ ý tưởng đó và cùng tìm điểm để so sánh.':'Em gửi đề bài và phần đã thử. Thầy sẽ cùng em đọc giả thiết, chọn hướng giải và kiểm tra từng bước.'}</p>{lesson&&<div className="inline-figure"><GeometryFigure figure={lesson.figure} title={lesson.title}/><small>Hình minh họa, không dùng thay cho giả thiết.</small></div>}<div className="start-hint"><Lightbulb size={18}/><span>{lesson?'Sơ đồ bên cạnh giúp em định hướng. Nhấn Gửi để bắt đầu.':'Thầy hỗ trợ hình học THCS, trọng tâm là tứ giác lớp 8.'}</span></div></div>:messages.map((m,i)=>{const parsed=m.role==='assistant'?parseTutorResponse(m.content):null;return <article className={`message ${m.role}`} key={i}>{m.role==='assistant'?<TutorAvatar/>:<span className="student-avatar">Em</span>}<div className="message-body"><span className="message-author">{m.role==='assistant'?'Gia sư hình học · AI':'Em'}</span>{parsed?.plan&&<details className="message-map"><summary>Sơ đồ định hướng của lượt này</summary><LearningMap plan={parsed.plan} source="Theo nội dung bài"/></details>}<div className="message-content">{i<messages.length-2?<details className="past-message"><summary>Xem lượt trao đổi trước</summary>{parsed?<MathText text={parsed.text}/>:m.content}</details>:parsed&&i===messages.length-1?<Typed text={parsed.text}/>:parsed?<MathText text={parsed.text}/>:m.content}</div></div></article>;})}{busy&&<div className="working" role="status"><TutorAvatar/><div><span className="thinking-dots"><i/><i/><i/></span><p>Thầy đang kiểm tra dữ kiện và hướng giải…</p></div><button onClick={()=>abort.current?.abort()}>Dừng</button></div>}</div>{error&&<p className="error" role="alert">{error}</p>}{messages.length>0&&<div className="followups"><button disabled={busy} onClick={()=>{setFigureRevision(v=>v+1);document.querySelector('.current-problem')?.scrollIntoView({behavior:'smooth',block:'start'});}} >Vẽ lại hình</button><button disabled={busy} onClick={()=>void send('Em cần một gợi ý nhỏ cho bước đang làm, chưa cần toàn bộ lời giải.')}>Gợi ý thêm</button><button disabled={busy} onClick={()=>void send('Thầy hãy giúp em kiểm tra đúng một bước em vừa làm; chưa đưa đáp án hoặc lời giải hoàn chỉnh.')}>Kiểm tra bước em làm</button><button disabled={busy} onClick={()=>void send('Hãy cho em một bài tương tự trong chủ đề tứ giác, chưa kèm đáp án.')}>Bài tương tự</button></div>}<form className="composer" onSubmit={e=>{e.preventDefault();void send();}}><label className="sr-only" htmlFor="problem">Nhập đề bài hoặc bài làm</label><textarea id="problem" ref={inputRef} value={input} rows={3} maxLength={6000} disabled={busy} placeholder={mode==='review'?'Nhập đề bài và từng bước trong lời giải của em…':mode==='compare'?'Nhập đề bài và các ý tưởng em muốn đối chiếu…':'Nhập đề bài hoặc chia sẻ bước em đang vướng…'} onChange={e=>setInput(e.target.value)} onKeyDown={e=>{if(e.key==='Enter'&&!e.shiftKey&&!e.nativeEvent.isComposing){e.preventDefault();void send();}}}/><div className="composer-bottom"><button type="button" className="preview-geometry-button" disabled={!input.trim()||busy} onClick={previewGeometry}>Xem hình & lý thuyết</button><span>{input.length}/6000 <small>· Shift + Enter để xuống dòng</small></span><button className="primary send-button" type="submit" disabled={busy||!input.trim()}>{busy?<LoaderCircle size={18} className="spin"/>:<ArrowUp size={18}/>}Gửi</button></div></form><p className="chat-foot">Bạn có thể khảo sát đánh giá ứng dụng bất cứ lúc nào. Lời mời khảo sát được nhắc lại mỗi 3 phút.</p></div><aside className="reasoning-panel"><LearningMap plan={displayPlan} source={mapSource}/><div className="self-check"><h3><CheckCheck size={18}/>Em tự kiểm tra</h3>{['Em nêu được giả thiết và kết luận','Em giải thích được bước then chốt','Em có thể tự làm lại'].map(s=><label key={s}><input type="checkbox" checked={checkpoints.includes(s)} onChange={e=>setCheckpoints(e.target.checked?[...checkpoints,s]:checkpoints.filter(v=>v!==s))}/><span>{s}</span></label>)}<p>Đánh dấu theo cảm nhận của em, không phải điểm do AI chấm.</p></div><LearnerPanel state={learner} onChange={setLearner}/><div className="side-tip"><span>NHỚ MỘT ĐIỀU</span><p>Hình vẽ gợi ý cho ta phỏng đoán.<br/>Lập luận mới giúp ta kết luận.</p></div></aside></div></section>}{notice&&<p className="notice" role="status">{notice}</p>}{view!=='chat'&&error&&<p className="error" role="alert">{error}</p>}<footer className="creators-footer"><a href="https://app.netlify.com/projects/poster-online-khkt/overview" target="_blank" rel="noopener noreferrer">Poster khoa học online <ArrowUpRight size={15}/></a><div><h2>NGƯỜI SÁNG TẠO</h2><p className="creator-names"><span>Phan Trí Dũng</span><span>Phạm Nam Hải</span></p><p>Giáo viên hướng dẫn: <strong>GV. Trần Ngọc Phú Sang</strong></p></div><p className="footer-purpose">Hiểu vì sao, rồi mới kết luận.<small>Phân tích · Tổng hợp · So sánh · Khái quát hóa</small></p></footer></main></div>
  <Dialog open={settings} onOpenChange={v=>{if(!checking){setSettings(v);if(!v)setDraftCode('');}}}><DialogContent onCloseAutoFocus={e=>{e.preventDefault();(inputRef.current||brandRef.current)?.focus({preventScroll:true});}} className="connection-dialog"><DialogHeader><span className="dialog-symbol"><KeyRound size={25}/></span><DialogTitle>Kết nối với gia sư AI</DialogTitle><DialogDescription>Nhập mã truy cập do giáo viên cung cấp. Sau khi kết nối, em sẽ điền thông tin để bắt đầu buổi học.</DialogDescription></DialogHeader><form onSubmit={e=>{e.preventDefault();void connect();}}><label>Mã truy cập<input type="password" value={draftCode} autoComplete="off" onChange={e=>setDraftCode(e.target.value)} placeholder="Nhập mã truy cập của lớp"/></label><p className="caption">Đây là mã vào lớp, không phải khóa Gemini API. Mã chỉ được giữ trong phiên đang mở.</p>{connectionError&&<p className="error" role="alert">{connectionError}</p>}<button className="primary full-width" disabled={checking||draftCode.trim().normalize('NFC').length<10}>{checking?<LoaderCircle className="spin" size={18}/>:<KeyRound size={18}/>} {checking?'Đang kiểm tra kết nối…':'Kiểm tra & kết nối'}</button>{code&&<button className="quiet full-width" type="button" disabled={busy||checking} onClick={()=>{setCode('');setSettings(false);}}>Ngắt kết nối</button>}</form></DialogContent></Dialog>
- <Dialog open={profileOpen&&!!code} onOpenChange={setProfileOpen}><DialogContent onCloseAutoFocus={e=>{e.preventDefault();(inputRef.current||brandRef.current)?.focus({preventScroll:true});}} className="profile-dialog"><DialogHeader><span className="step-label">ĐÃ KẾT NỐI AI · BƯỚC 2</span><DialogTitle>Thầy hiểu em hơn,<br/>mình học phù hợp hơn.</DialogTitle><DialogDescription>Thông tin người học sẽ được gửi cùng đánh giá cuối buổi đến biểu mẫu của giáo viên khi em đồng ý gửi.</DialogDescription></DialogHeader><form onSubmit={saveProfile}><div className="form-grid"><label>Họ và tên <span>*</span><input required maxLength={120} value={draft.name} onChange={e=>setDraft({...draft,name:e.target.value})} autoComplete="name" placeholder="Họ và tên của em"/></label><label>Trường đang học <span>*</span><input required maxLength={120} value={draft.school} onChange={e=>setDraft({...draft,school:e.target.value})} placeholder="Tên trường"/></label><label>Email <span>*</span><input required type="email" maxLength={180} value={draft.email||''} onChange={e=>setDraft({...draft,email:e.target.value})} autoComplete="email" placeholder="Email liên hệ"/></label><label>Lớp<input maxLength={40} value={draft.className} onChange={e=>setDraft({...draft,className:e.target.value})} placeholder="Ví dụ: 8A1"/></label><label>Mức độ tự nhận xét<select value={draft.level} onChange={e=>setDraft({...draft,level:e.target.value})}>{levels.map(l=><option key={l}>{l}</option>)}</select></label><label>Mục tiêu học tập<select value={draft.goal} onChange={e=>setDraft({...draft,goal:e.target.value})}>{['Cải thiện điểm số','Thi học kỳ','Thi vào 10','HSG'].map(g=><option key={g}>{g}</option>)}</select></label></div><details className="profile-extra"><summary>Bổ sung thông tin học tập (không bắt buộc)</summary><div className="form-grid"><label>Điểm trung bình Toán<input type="number" min="0" max="10" step="0.1" value={draft.average} onChange={e=>setDraft({...draft,average:e.target.value})}/></label><label>Giáo