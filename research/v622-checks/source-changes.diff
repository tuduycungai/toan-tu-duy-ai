+export function requestedExerciseCount(student){
+ const n=student.trim().match(/^(?:hãy\s+)?(?:tạo|sinh)\s+(?:đúng\s+)?([5-9]|10)\s+câu\b/iu)?.[1];
+ return n?Number(n):0;
+}
+
+export function exerciseSetGuidance(student){
