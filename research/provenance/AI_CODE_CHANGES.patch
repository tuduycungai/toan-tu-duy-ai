+import {mkdir,writeFile} from 'node:fs/promises';import {spawnSync} from 'node:child_process';import {loadTS} from '../tests/load-ts.mjs';
+const {worksheets,worksheetDrawings}=await loadTS('lib/worksheets.ts');const {toTikZ}=await loadTS('lib/geometry.ts');
