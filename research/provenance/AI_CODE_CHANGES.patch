+for(const bad of [socratic+'\nCòn điều gì nữa?',socratic.replace('BUOC_TIEP:','NHIEM_VU:'),socratic+socratic,socratic.replace('Thao tác tư duy:','Ghi chú:'),socratic+'\nLời giải: Ta có ABCD là hình thoi.',socratic+'\nBước 2: Từ đó suy ra đáp án.',socratic.replace(/Gợi mở:.*/,'Kinh nghiệm: Em đã đọc lời giải.\n[KET_THUC_BUOI_HOC]')])test('invalid/answer-like provider output is replaced with one safe question',()=>{const result=guardTutorOutput(bad,history('Vâng, hiểu rồi'));assert.notEqual(result,bad);check(result);});
